# ---------------------------------------------------------------------------
# COPY THIS FILE TO `.env` AND FILL IN THE VALUES.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore, so it never gets uploaded to GitHub.
# When running on GitHub Actions you do NOT use this file at all - you paste
# the same values into Settings > Secrets and variables > Actions instead.
# See SETUP.md for exactly where to get each one.
# ---------------------------------------------------------------------------

# --- Writing the scripts (required) ----------------------------------------
# https://platform.deepseek.com  ->  API keys
DEEPSEEK_API_KEY=

# --- The narrator's voice (required with the default TTS provider) ----------
# https://elevenlabs.io/app/settings/api-keys   ~$1.10 per 11-minute video
ELEVENLABS_API_KEY=

# --- Google AI Studio: vision checks, backup writer, fallback AI video ------
# --- (Gemini Omni Flash), and the narration voice if tts.provider=gemini -----
# https://aistudio.google.com/apikey   (one key covers all four jobs)
GEMINI_API_KEY=

# --- Alternative narration voice (only if you pick Qwen in the bake-off) ----
# https://modelstudio.console.alibabacloud.com  (Singapore region)
QWEN_API_KEY=

# --- Alternative narration voice (only if you pick Speechify in the bake-off)
# https://platform.speechify.ai  ->  API keys
SPEECHIFY_API_KEY=

# --- Research (required) ----------------------------------------------------
# https://dashboard.exa.ai        free tier: 20,000 searches/month
EXA_API_KEY=
# https://app.tavily.com          free tier: 1,000 searches/month  (fallback)
TAVILY_API_KEY=

# --- Stock footage (required) -----------------------------------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/   (fallback library)
PIXABAY_API_KEY=

# --- AI visuals and thumbnails (required) ----------------------------------
# Keyframe images, image-to-video clips, depth maps and thumbnail images all go
# through one pay-per-use key. Budget is capped per video by visuals.budget_usd
# in config/channel.json (default $5 - real footage comes first on this channel).
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Running it from your phone (required for the chat) ---------------------
# Create the bot with @BotFather on Telegram; find your chat id by running
# `python tools/telegram_setup.py --find-chat-id`. Full walkthrough in
# docs/TELEGRAM_SETUP.md. Leave these blank and the pipeline still runs from
# the command line - it just doesn't narrate itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string (`openssl rand -hex 32`). The Cloudflare Worker gets
# the same value, and Telegram sends it back on every delivery so the Worker
# can tell a real message from someone who guessed the URL. Only needed on the
# machine you run tools/telegram_setup.py from - not in GitHub Secrets.
TELEGRAM_WEBHOOK_SECRET=

# --- Uploading to YouTube (needed to review and publish from the chat) ------
# Without these the video is still built, and output/UPLOAD.md has everything
# you need to upload it by hand - but the chat can't send you a link to watch.
# Google Cloud Console > Credentials > OAuth client ID (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Only used when running inside GitHub Actions ---------------------------
# Actions injects this automatically. Leave blank locally.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

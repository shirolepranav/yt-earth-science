# ---------------------------------------------------------------------------
# COPY THIS FILE TO `.env` AND FILL IN THE VALUES.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore, so it never gets uploaded to GitHub.
# See SETUP.md for exactly where to get each one.
# ---------------------------------------------------------------------------

# --- Writing the scripts (required) ----------------------------------------
# https://platform.deepseek.com  ->  API keys
DEEPSEEK_API_KEY=

# --- The narrator's voice (required with the default TTS provider) ----------
# https://elevenlabs.io/app/settings/api-keys   ~$1.10 per 11-minute video
ELEVENLABS_API_KEY=

# --- Google AI Studio: vision checks, backup writer, fallback AI video ------
# --- (Gemini Omni Flash), and the narration voice if tts.provider=gemini -----
# https://aistudio.google.com/apikey   (one key covers all four jobs)
GEMINI_API_KEY=

# --- Alternative narration voice (only if you pick Qwen in the bake-off) ----
# https://modelstudio.console.alibabacloud.com  (Singapore region)
QWEN_API_KEY=

# --- Alternative narration voice (only if you pick Speechify in the bake-off)
# https://platform.speechify.ai  ->  API keys
SPEECHIFY_API_KEY=

# --- Research (required) ----------------------------------------------------
# https://dashboard.exa.ai        free tier: 20,000 searches/month
EXA_API_KEY=
# https://app.tavily.com          free tier: 1,000 searches/month  (fallback)
TAVILY_API_KEY=

# --- Stock footage (required) -----------------------------------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/   (fallback library)
PIXABAY_API_KEY=

# --- AI visuals and thumbnails (required) ----------------------------------
# Keyframe images, image-to-video clips, depth maps and thumbnail images all go
# through one pay-per-use key. Budget is capped per video by visuals.budget_usd
# in config/channel.json (default $5 - real footage comes first on this channel).
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Uploading to YouTube (needed for "Accept & upload" in the studio) -------
# Without these the video is still built and reviewed, and output/UPLOAD.md has
# everything you need to upload it by hand. Refresh token: tools/youtube_auth.py
# Google Cloud Console > Credentials > OAuth client ID (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Studio (optional) ------------------------------------------------------
# STUDIO_PORT=8765
# REMOTION_CONCURRENCY=5      # default: half your CPU cores
